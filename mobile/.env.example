# Copy this file to .env and fill in the values, then restart "npx expo start".
# Supabase dashboard > Project Settings > API
# Only the public "anon" key goes here. Never put the service-role key in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
